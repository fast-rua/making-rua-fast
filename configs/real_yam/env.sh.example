# The environment for this repository (docs/SETUP.md). scripts/install.sh writes it to $ROBOT_HOME/env.sh; source it
# in every shell that runs robotd, camerad, the dashboard or the episode launcher.
export ROBOT_HOME=${ROBOT_HOME:-$HOME/robot-cell}         # the install folder: venv, i2rt, Codex, runs
source "$ROBOT_HOME/.venv/bin/activate"
export I2RT_ROOT=$ROBOT_HOME/i2rt                        # i2rt v1.4.0: the YAM model and motor driver
export PYTHONPATH=$ROBOT_HOME/code                       # this repository's checkout (install.sh fills it in)
export MUJOCO_GL=egl                                     # headless rendering (the simulator's cameras)

# ---- the real cell only: fill these in and uncomment them (docs/SETUP.md, "The real cell")
# The CAN bus of each arm (set up with i2rt's tools; robotd never configures them):
# export YAM_CHANNELS=left=can_left,right=can_right
# The RealSense cameras by serial number (`rs-enumerate-devices -s`); the names are the ones the API uses:
# export YAM_CAMERAS="top=<serial>,front=<serial>,left_wrist=<serial>,right_wrist=<serial>"
# The cell calibration (docs/SETUP.md, "Calibration"):
# export YAM_CALIBRATION=$ROBOT_HOME/calibration.json
# Optional, "a,b,..." for both arms or "left=a,b,...;right=a,b,...":
# export YAM_GRIPPER_LIMITS="left=<closed>,<open>;right=<closed>,<open>"   # motor rad; overrides the calibration's
# export YAM_PARK_Q="left=q1,...,q6;right=q1,...,q6"                         # rad; overrides the calibration's rest pose
# What the demo runs used on our cell: i2rt's gravity compensation scaled per joint (measured on our arms; start
# from 1.0 for every joint on yours), and the calibration's wrist-camera mount corrections left out:
# export YAM_GRAVITY_FACTORS=1.0,1.2,1.1,0.5,1.0,1.0
# export YAM_CALIBRATION_IGNORE=wrist_camera_corrections
